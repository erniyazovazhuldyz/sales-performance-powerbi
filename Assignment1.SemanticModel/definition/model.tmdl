model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: ru-RU
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Transform File from Stores'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Transform File from Stores\Helper Queries'

	annotation PBI_QueryGroupOrder = 0

queryGroup sales

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Reseller","Sales Order","Sales","Territory","Stores","Sample File","Parameter1","Transform Sample File","Transform File","Customer","New Customer","SalesPlan","SalesPlanNew","Sales Plan Final","Product","Sales Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table Reseller
ref table 'Sales Order'
ref table Sales
ref table Territory
ref table Stores
ref table Customer
ref table 'Sales Plan Final'
ref table Calendar
ref table Product
ref table 'Sales Measures'

ref cultureInfo en-US

