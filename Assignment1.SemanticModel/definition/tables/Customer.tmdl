	column 'Postal Code'
		dataType: string
		lineageTag: 6516af9a-698e-43f3-933b-8cfc2d63c0b2
		summarizeBy: none
		sourceColumn: Postal Code

		annotation SummarizationSetBy = Automatic

	column Occupancy
		dataType: string
		lineageTag: a8113976-100c-4c2b-9c6f-2c5b64a477fb
		summarizeBy: none
		sourceColumn: Occupancy

		annotation SummarizationSetBy = Automatic

	column Membership
		dataType: string
		lineageTag: 4033c360-915b-4dd5-a632-c1c13d9645e6
		summarizeBy: none
		sourceColumn: Membership

		annotation SummarizationSetBy = Automatic

	column Income
		dataType: double
		lineageTag: 797d63b9-aeff-4569-a06e-0e6788591abf
		summarizeBy: none
		sourceColumn: Income

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column BirthYear
		dataType: int64
		formatString: 0
		lineageTag: f5878de4-d0f5-415d-ac33-a4687ac3dbc0
		summarizeBy: none
		sourceColumn: BirthYear

		annotation SummarizationSetBy = Automatic

	column Age = IF(ISBLANK(Customer[BirthYear]), BLANK(), YEAR(TODAY()) - Customer[BirthYear])
		formatString: 0
		lineageTag: ccd9f4b9-345a-4c6a-8123-0458e0234d7d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Age Group' =
			
			SWITCH(
			    TRUE(),
			    ISBLANK(Customer[Age]), "Unknown",
			    Customer[Age] < 35, "Under 35",
			    Customer[Age] < 45, "35-44",
			    Customer[Age] < 55, "45-54",
			    Customer[Age] < 65, "55-64",
			    "65+"
			)
		lineageTag: a650ff34-ac11-4442-b7ac-c9a0109586f1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Age Group Order' =
			
			SWITCH(
			    Customer[Age Group],
			    "Under 35", 1,
			    "35-44", 2,
			    "45-54", 3,
			    "55-64", 4,
			    "65+", 5,
			    6
			)
		formatString: 0
		lineageTag: 5ee77ab9-f2d6-4857-8c9a-e0570207e7ae
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Customer = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("C:\Users\Жулдыз\Desktop\PowerBI\Customer_data.xlsx"), null, true),
				    Customer_data_Sheet = Source{[Item="Customer_data",Kind="Sheet"]}[Data],
				    #"Changed Type" = Table.TransformColumnTypes(Customer_data_Sheet,{{"Column1", type text}, {"Column2", type text}, {"Column3", type text}, {"Column4", type text}, {"Column5", type text}, {"Column6", type text}}),
				    #"Removed Top Rows" = Table.Skip(#"Changed Type",1),
				    #"Promoted Headers" = Table.PromoteHeaders(#"Removed Top Rows", [PromoteAllScalars=true]),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Promoted Headers",{{"CustomerKey2", type text}, {"Customer", type text}, {"City", type text}, {"State-Province", type text}, {"Country-Region", type text}, {"Postal Code", type text}}),
				    #"Removed Top Rows1" = Table.Skip(#"Changed Type1",2),
				    #"Filled Down" = Table.FillDown(#"Removed Top Rows1",{"Country-Region"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Filled Down",{{"CustomerKey2", "CustomerKey"}}),
				    #"Removed Duplicates" = Table.Distinct(#"Renamed Columns", {"CustomerKey"}),
				    #"Removed Blank Rows" = Table.SelectRows(#"Removed Duplicates", each not List.IsEmpty(List.RemoveMatchingItems(Record.FieldValues(_), {"", null}))),
				    #"Replaced Value" = Table.ReplaceValue(#"Removed Blank Rows","AW","",Replacer.ReplaceText,{"CustomerKey"}),
				    #"Changed Type2" = Table.TransformColumnTypes(#"Replaced Value",{{"CustomerKey", Int64.Type}}),
				    #"Merged Queries" = Table.NestedJoin(#"Changed Type2", {"CustomerKey"}, #"New Customer", {"CustomerKey"}, "New Customer", JoinKind.LeftOuter),
				    #"Expanded New Customer" = Table.ExpandTableColumn(#"Merged Queries", "New Customer", {"Occupancy", "Membership", "Income", "BirthYear"}, {"Occupancy", "Membership", "Income", "BirthYear"}),
				    #"Changed Type3" = Table.TransformColumnTypes(#"Expanded New Customer",{{"BirthYear", Int64.Type}}),
				    #"Replaced Value1" = Table.ReplaceValue(#"Changed Type3",null,-1,Replacer.ReplaceValue,{"CustomerKey"})
				in
				    #"Replaced Value1"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

