table Customer
	lineageTag: e2b135c2-86a2-42cc-b1f1-7dc37ad7b0bc

	measure 'Gold Income' =
			
			CALCULATE (
			    SUM ( Customer[Income] ),
			    Customer[Membership] = "Gold",
			    Customer[Age Group] IN { "Under 35", "35-44" }
			)
		lineageTag: 252b457f-af4d-4508-89b1-59b3c71712f0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column CustomerKey
		dataType: double
		formatString: 0
		lineageTag: cacaed68-f26b-4bfa-b61f-7903fd07e2d3
		summarizeBy: none
		sourceColumn: CustomerKey

		annotation SummarizationSetBy = Automatic

	column Customer
		dataType: string
		lineageTag: 4965b269-a02b-49e6-a8a1-80423b48a5f9
